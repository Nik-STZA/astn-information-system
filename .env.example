# AfricanSTN Information System - environment variables
#
# Copy this file to .env.local for local development.
# In production (Netlify), set these in Site Settings -> Environment variables.
# NEVER commit .env.local or any file containing real secrets.

# ============================================================
# Supabase - database and auth
# ============================================================
# The Supabase project URL (visible to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://vjtdcsshsqnmfcftlver.supabase.co

# The Supabase anon key (visible to the browser - security relies on RLS, not key secrecy)
# Find in Supabase dashboard -> Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Application authentication
# ============================================================
# Comma-separated list of email addresses allowed to sign in.
# Add new emails when expanding access; in v1 this is just Nik's email.
ALLOWED_EMAILS=nik@stza.io

# ============================================================
# Cloud Run - AfricanSTN OS modules API
# ============================================================
# Base URL for the AfricanSTN OS API on Cloud Run (data protection,
# compliance, content, pipeline modules).
CLOUD_RUN_API_URL=https://africastn-api-782190795609.europe-west1.run.app
